# Cache-Control Headers for Static Assets
# This improves performance by reducing server requests

<IfModule mod_expires.c>
    ExpiresActive On

    # Default expiration: 1 hour
    ExpiresDefault "access plus 1 hour"

    # HTML (for any HTML files in public)
    ExpiresByType text/html "access plus 0 seconds"

    # CSS and JavaScript with content hashes - cache for 1 year
    <FilesMatch "\.(css|js)$">
        # Check if file has hash in name (e.g., main-abc123.css)
        <If "%{REQUEST_URI} =~ /-[a-zA-Z0-9_-]+\.(css|js)$/">
            ExpiresDefault "access plus 1 year"
            Header set Cache-Control "public, max-age=31536000, immutable"
        </If>
        # Files without hash - shorter cache
        <Else>
            ExpiresDefault "access plus 1 week"
            Header set Cache-Control "public, max-age=604800"
        </Else>
    </FilesMatch>

    # Images - cache for 1 month
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"

    # Fonts - cache for 1 year
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

    # Audio and Video - cache for 1 month
    ExpiresByType audio/ogg "access plus 1 month"
    ExpiresByType video/mp4 "access plus 1 month"
    ExpiresByType video/webm "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    # Add Cache-Control headers for better caching control

    # For hashed assets in /assets/ directory
    <FilesMatch "^[^.]+\-[a-zA-Z0-9_-]+\.(css|js|jpg|jpeg|png|gif|webp|svg|woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # For font files (even without hash)
    <FilesMatch "\.(ttf|otf|eot|woff|woff2|svg)$">
        Header set Cache-Control "public, max-age=31536000"
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>

    # Remove ETag (we use Cache-Control instead)
    Header unset ETag
</IfModule>

FileETag None
