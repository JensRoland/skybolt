{
  "name": "@skybolt/vite-plugin",
  "version": "3.4.0",
  "description": "Vite plugin for Skybolt - High-performance asset caching for multi-page applications",
  "type": "module",
  "author": "Jens Roland <mail@jensroland.com> (https://jensroland.com)",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": {
      "import": "./index.js"
    }
  },
  "files": [
    "index.js",
    "client.js",
    "client.min.js",
    "sw.js",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run minify",
    "minify": "esbuild client.js --minify --outfile=client.min.js && esbuild sw.js --minify --outfile=sw.min.js",
    "version": "node scripts/sync-version.js && git add .",
    "postversion": "git commit -m \"chore(vite-plugin): release v$npm_package_version\" && git tag vite-plugin-v$npm_package_version && echo \"\\nRun 'git push origin main --tags' to publish\""
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "skybolt",
    "caching",
    "service-worker",
    "performance",
    "assets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JensRoland/skybolt.git",
    "directory": "packages/vite-plugin"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.0"
  },
  "workspaces": [
    "."
  ]
}
