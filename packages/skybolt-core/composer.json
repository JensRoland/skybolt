{
    "name": "skybolt/skybolt-core",
    "description": "High-performance asset management framework with intelligent client-side caching",
    "version": "2.2.1",
    "type": "library",
    "keywords": ["assets", "performance", "cache", "vite", "optimization", "web-performance"],
    "license": "MIT",
    "authors": [
        {
            "name": "Jens Roland",
            "email": "mail@jensroland.com"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "Skybolt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Skybolt\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
